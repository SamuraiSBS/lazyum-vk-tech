# Keep real values only in the untracked .env.local or in your deployment secret store.
# The deterministic planner is intentionally explicit and needs no cloud credential.
VK_HACKATHON_LLM_PROVIDER=deterministic

# Both values are required for the restricted demo. Keep real values in .env.local
# or the deployment secret store; never commit credentials.
# VK_HACKATHON_DEMO_AUTH_USER=
# VK_HACKATHON_DEMO_AUTH_PASSWORD=

# To call an explicitly attested model through Yandex AI Studio, set every value below.
# There is deliberately no default model: this repository does not assert organizer model facts.
# VK_HACKATHON_LLM_PROVIDER=yandex-ai-studio
# YANDEX_CLOUD_API_KEY=<service-account API key with yc.ai.languageModels.execute>
# YANDEX_CLOUD_FOLDER_ID=<Yandex Cloud folder ID>
# YANDEX_CLOUD_MODEL_NAME=<model-card name>
# YANDEX_CLOUD_MODEL_URI=gpt://<folder_ID>/<explicit-model-id>
# YANDEX_CLOUD_MODEL_TOTAL_PARAMETERS_B=<total parameter count, maximum 35>
# YANDEX_CLOUD_MODEL_OPEN_WEIGHTS=true
# YANDEX_CLOUD_MODEL_LICENSE=Apache-2.0
# Optional: default https://ai.api.cloud.yandex.net/v1
# YANDEX_CLOUD_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Optional: default 60000, valid range 1..120000
# VK_HACKATHON_LLM_TIMEOUT_MS=60000
# Optional bounded retry/token envelope. Defaults: attempts=2, input=8000,
# output=1500, total=18000. The adapter estimates UTF-8 input conservatively
# as ceil(bytes / 3), sends max_tokens=output budget, and refuses a fetch that
# would exceed the total envelope.
# VK_HACKATHON_LLM_MAX_ATTEMPTS=2
# VK_HACKATHON_LLM_INPUT_TOKEN_BUDGET=8000
# VK_HACKATHON_LLM_OUTPUT_TOKEN_BUDGET=1500
# VK_HACKATHON_LLM_TOTAL_TOKEN_BUDGET=18000
